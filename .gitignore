# orb.yml is "packed" from source, and not published directly from the repository.
orb.yml
.DS_Store

## Environment normalization:
/.bundle/
/vendor/bundle
/lib/bundler/man/

# for a library or gem, you might want to ignore these files since the code is
# intended to run in multiple environments; otherwise, check them in:
# Gemfile.lock
# .ruby-version
# .ruby-gemset

# unless supporting rvm < 1.11.0 or doing something fancy, ignore this:
.rvmrc

# Used by RuboCop. Remote config files pulled in from inherit_from directive.
# .rubocop-https?--*

.idea
.vscode
/src/ios.yml

# Claude Code — commit project agents/skills/hooks/settings, keep local
# settings out. Negating a path inside an ignored directory requires the
# `.claude/*` form (a trailing-slash `.claude/` pattern can't be un-ignored
# piecemeal), which is why the entries below stay this shape.
.claude/*
!.claude/agents/
!.claude/skills/
!.claude/hooks/
!.claude/settings.json
Icon?

# Fastlane fixture (tests/fixture) — CI-only outputs
tests/fixture/vendor/
tests/fixture/.bundle/
tests/fixture/fastlane/test_output/
tests/fixture/fastlane/report.xml
tests/fixture/TestResults.xcresult/
tests/fixture/coverage.xml
